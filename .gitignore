/code/01-basics/*/slice
/code/01-basics/*/map
/code/01-basics/*/defer
/code/01-basics/*/gc
/code/01-basics/*/memory
/code/01-basics/*/context
/code/01-basics/*/make-new
/code/02-important/*/iface
/code/02-important/*/mutex
/code/02-important/*/pool
/code/02-important/*/panic
/code/02-important/*/compile
/code/03-advanced/*/gin
/code/03-advanced/*/gorm
/code/03-advanced/*/pprof

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Editor temp
*~

# Local config
.env
.env.local

# 防止意外提交 Go build 产物（更通用的规则）
/code/*/*/*[!.]*
